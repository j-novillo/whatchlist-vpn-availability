# Copia este archivo a .env y rellena solo lo que ya tengas.
# No subas .env al repositorio. Este archivo no contiene secretos.

# --- TMDB -----------------------------------------------------------------
# Crea una clave en https://www.themoviedb.org/settings/api
# Sin ella el programa no traduce ni corrige erratas: busca el texto tal cual.
TMDB_API_KEY=

# Opcional, para pruebas sin clave: JSON {"Como lo escribí": "English Title"}
# TMDB_FIXTURES=tests/fixtures/tmdb.json

# --- Google (Docs y, si tienes Workspace, Keep oficial) -------------------
# JSON de una cuenta de servicio. Comparte el Doc con el email de esa cuenta.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Solo la API oficial de Keep: usuario de Workspace al que suplantar.
GOOGLE_DELEGATED_USER=
# Alternativa: cliente OAuth de escritorio y el token que guarda el programa.
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_TOKEN_FILE=

# --- Qué nota y qué documento ---------------------------------------------
# El id de Keep cambia cada vez que se recrea la nota. El título es más estable.
KEEP_NOTE_ID=
KEEP_NOTE_TITLE=
DOCS_SNAPSHOT_ID=

# auto usa la API oficial si hay credenciales. Nunca elige solo el backend no oficial.
# Valores: auto | official | unofficial
KEEP_BACKEND=auto

# Backend no oficial (gkeepapi). No recomendado. Inestable.
# No documentamos cómo extraer un master token. Si ya lo tienes, ponlo aquí
# y nunca en el repositorio. Instala además: pip install -e '.[unofficial]'
# KEEP_BACKEND=unofficial
# KEEP_USERNAME=
# KEEP_MASTER_TOKEN=
# KEEP_DEVICE_ID=

# --- Ejecución ------------------------------------------------------------
# 1 = no crear ni borrar notas de Keep.
DRY_RUN=0
# En dry-run, 1 = actualizar igualmente el snapshot (Doc o fichero).
UPDATE_SNAPSHOT_IN_DRY_RUN=0

# live | fixtures | browser
# browser no está implementado en la v1 (ver docs/limitaciones.md).
STREAMWITHVPN_BACKEND=live
# STREAMWITHVPN_FIXTURES=tests/fixtures/streamwithvpn/catalog.json
STREAMWITHVPN_TIMEOUT=20
